{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PIPIT_DEV_PORT",
        "VITE_PIPIT_URL",
        "PIPIT_NO_UPDATE_CHECK"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PIPIT_HOME",
        "PIPIT_NO_UPDATE_CHECK"
      ]
    }
  }
}
