{
  "extends": "@dipper/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    // Only the test files read Bun and Node globals; the library itself uses neither.
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["src"]
}
